{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@kancode/sdk",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "build": "bun ./script/build.ts",
    "prepublishOnly": "bun tsc"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "bun": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "bun": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./v2": {
      "bun": "./src/v2/index.ts",
      "types": "./dist/v2/index.d.ts",
      "import": "./dist/v2/index.js"
    },
    "./v2/client": {
      "bun": "./src/v2/client.ts",
      "types": "./dist/v2/client.d.ts",
      "import": "./dist/v2/client.js"
    },
    "./v2/gen/client": {
      "bun": "./src/v2/gen/client/index.ts",
      "types": "./dist/v2/gen/client/index.d.ts",
      "import": "./dist/v2/gen/client/index.js"
    },
    "./v2/server": {
      "bun": "./src/v2/server.ts",
      "types": "./dist/v2/server.d.ts",
      "import": "./dist/v2/server.js"
    },
    "./v2/types": {
      "bun": "./src/v2/gen/types.gen.ts",
      "types": "./dist/v2/gen/types.gen.d.ts",
      "import": "./dist/v2/gen/types.gen.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "@hey-api/openapi-ts": "0.90.10",
    "@tsconfig/node22": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "cross-spawn": "catalog:"
  },
  "description": "TypeScript SDK for the KanCode server API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puetsua/kancode.git",
    "directory": "packages/sdk/js"
  },
  "publishConfig": {
    "access": "public"
  }
}
